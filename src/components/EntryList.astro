---
interface Props {
  entries: { id: string; data: { title: string; description: string; tags: string[] } }[];
  section: 'projects' | 'writing';
}
const { entries, section } = Astro.props;
---

<div class="entry-list">
  {entries.map((entry, index) => (
    <a class="entry" href={`/${section}/${entry.id}/`}>
      <span class="entry-number" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.description}</p>
        <div class="tags">
          {entry.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </div>
      <span class="entry-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  ))}
</div>
