---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Writing"
  description="Notes and technical articles by Joppe Iemants on software, Artificial Intelligence, and things learned while building."
  noindex={entries.length === 0}
>
  <div id="top"></div>
  <header class="page-heading">
    <p class="eyebrow">THE NOTEBOOK</p>
    <h1>
      Writing<span class="accent">.</span>
    </h1>
    <p>Things learned. Ideas worth keeping.</p>
  </header>
  {entries.length ? (
    <EntryList entries={entries} section="writing" />
  ) : (
    <div class="empty-state">
      <span class="empty-symbol" aria-hidden="true">
        [ &nbsp; ]
      </span>
      <h2>A blank page, for now.</h2>
      <p>This is where I'll share technical articles and notes as I learn and build.</p>
      <a class="text-link" href="/projects/">
        Explore what I'm building ↗
      </a>
    </div>
  )}
</Base>
