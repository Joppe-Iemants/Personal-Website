---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getCollection } from 'astro:content';
import { profiles } from '../data/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <div id="top"></div>
  <section class="hero" aria-labelledby="intro-title">
    <div class="eyebrow">
      <span class="status-dot"></span> STUDENT & BUILDER · BELGIUM
    </div>
    <h1 id="intro-title">
      Joppe Iemants<span class="accent">.</span>
    </h1>
    <p class="hero-statement">
      Exploring intelligence.
      <br />
      Building what comes next.
    </p>
    <p class="hero-description">
      Applied Computer Science student at Howest,
      <br class="desktop-break" /> specializing in Artificial Intelligence.
    </p>
    <div class="hero-links">
      <a class="button" href="/projects/">
        Explore my projects <span aria-hidden="true">↗</span>
      </a>
      {profiles.map((p) => (
        <a class="text-link" href={p.url}>
          {p.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="hero-foot">
      <span>A personal space for ideas, code, and things I make.</span>
      <a href="#about" aria-label="Read more about me">
        SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section class="about section" id="about" aria-labelledby="about-title">
    <div class="section-label">
      <span class="index">01 /</span>
      <h2 id="about-title">A little about me</h2>
    </div>
    <div class="about-body">
      <p class="large-copy">
        Interested in how things work.
        <br />
        <span>Even more interested in what they could become.</span>
      </p>
      <p>
        I'm Joppe, an Applied Computer Science student at Howest in Belgium. My focus is Artificial
        Intelligence, with software as a way to turn ideas into something useful.
      </p>
      <p>
        This is my corner of the web: a home for the projects I build, the experiments I try, and
        the things I learn along the way.
      </p>
      <div class="facts">
        <div>
          <span>STUDYING</span>
          <strong>Applied Computer Science</strong>
        </div>
        <div>
          <span>FOCUS</span>
          <strong>Artificial Intelligence</strong>
        </div>
        <div>
          <span>BASED AT</span>
          <strong>Howest, Belgium</strong>
        </div>
      </div>
    </div>
  </section>
  <section class="section work" aria-labelledby="work-title">
    <div class="section-heading">
      <div class="section-label">
        <span class="index">02 /</span>
        <h2 id="work-title">On the workbench</h2>
      </div>
      <a class="text-link" href="/projects/">
        All projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <EntryList entries={projects} section="projects" />
  </section>
  <section class="closing">
    <span class="eyebrow">A WORK IN PROGRESS, BY DESIGN</span>
    <h2>
      More to build.
      <br />
      <span>More to share.</span>
    </h2>
    <p>This space will grow with my projects, experiments, and technical writing.</p>
    <a class="text-link" href="/writing/">
      Visit the notebook <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
