---
import '../styles/global.css';
import { profiles, site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: { title: string; date: Date };
}
const { title, description = site.description, noindex = false, article } = Astro.props;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} — Applied Computer Science & AI`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: article.title,
      description,
      datePublished: article.date.toISOString(),
      mainEntityOfPage: canonical,
      author: { '@type': 'Person', name: site.name, url: site.url },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: canonical,
      mainEntity: {
        '@type': 'Person',
        name: site.name,
        url: site.url,
        description: site.description,
        sameAs: profiles.filter((p) => !p.url.startsWith('mailto:')).map((p) => p.url),
        affiliation: { '@type': 'CollegeOrUniversity', name: 'Howest' },
        knowsAbout: ['Applied Computer Science', 'Artificial Intelligence'],
      },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f5f5ef" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Joppe Iemants, home">
          ji<span>.</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>
            Home
          </a>
          <a href="/projects/" aria-current={path.startsWith('/projects/') ? 'page' : undefined}>
            Projects
          </a>
          <a href="/writing/" aria-current={path.startsWith('/writing/') ? 'page' : undefined}>
            Writing
          </a>
          <a href="/#about">
            About <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Joppe Iemants</p>
        <p>Made with curiosity. Built with Astro.</p>
        <div class="footer-links">
          {profiles.map((p) => (
            <a href={p.url}>
              {p.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href="#top">Back to top ↑</a>
        </div>
      </footer>
    </div>
  </body>
</html>
